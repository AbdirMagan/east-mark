# Android build-time config, read by the Secrets Gradle Plugin
# (see secrets { } in app/build.gradle.kts). Copy to .env in this folder.
#
# Values here become BuildConfig fields. Only publishable values belong here:
# anything in an APK can be extracted. NEVER put SUPABASE_SERVICE_ROLE_KEY here.
#
# Note: the current Android app is the original offline prototype (Room only)
# and does not read these yet. They are in place for the Supabase-backed app.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
API_BASE_URL=http://10.0.2.2:4000/api/v1
