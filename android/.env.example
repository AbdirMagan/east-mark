# Android build-time config, read by the Secrets Gradle Plugin
# (see secrets { } in app/build.gradle.kts). Copy to .env in this folder.
#
# Every value must be NON-EMPTY. The plugin emits empty values unquoted, so
# `KEY=` generates `String KEY = ;` in BuildConfig.java and the build fails
# with "illegal start of expression". Keep a placeholder until you have the
# real value.
#
# Only publishable values belong here: anything in an APK can be extracted.
# NEVER put SUPABASE_SERVICE_ROLE_KEY here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
# Where the backend is, as seen FROM the device:
#   Emulator:       http://10.0.2.2:4000/api/v1   (alias for the PC)
#   Physical phone: http://<your-PC-Wi-Fi-IP>:4000/api/v1
# A phone plugged in by USB still reaches the backend over Wi-Fi, so
# localhost (the phone itself) and 10.0.2.2 both fail there. Find the IP
# with `ipconfig`, keep the phone on the same Wi-Fi, and allow port 4000
# through the Windows firewall.
API_BASE_URL=http://10.0.2.2:4000/api/v1
