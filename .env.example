# East-Market :: environment template
# Copy to .env and fill in. Never commit .env.
#
# WHICH KEY GOES WHERE
#   SUPABASE_ANON_KEY          safe to ship in Android, iOS, web and admin
#                              bundles. It is protected by row level security.
#   SUPABASE_SERVICE_ROLE_KEY  backend only. It BYPASSES every RLS policy.
#                              If it reaches a client bundle, every user's
#                              private data and the whole payment ledger are
#                              readable and writable by anyone who opens
#                              devtools. There is no recovering from that
#                              except rotating the key.

# A blank value counts as unset, so you can copy this file verbatim and fill in
# only what you need. The backend needs exactly two values to start.
#
# ---------------------------------------------------------------------------
# Supabase  (SUPABASE_URL and SUPABASE_ANON_KEY are the only required values)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Optional in development; REQUIRED in production. Needed for moderation,
# payments and the scheduled jobs. Anything that reaches for it without this
# set fails with a message saying so, rather than failing obscurely later.
SUPABASE_SERVICE_ROLE_KEY=            # backend only. Never in a client build.

# Only needed if the project still signs tokens with the legacy shared secret.
# Projects using asymmetric keys verify from JWKS and need nothing here.
SUPABASE_JWT_SECRET=                  # backend only, for verifying access tokens
DATABASE_URL=                         # backend only, for migrations and jobs

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---------------------------------------------------------------------------
# Web + admin (Vite only exposes variables prefixed with VITE_)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:4000
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Maps
# ---------------------------------------------------------------------------
# Restrict this key by platform and referrer in the Google Cloud console.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------
# Android: Firebase Cloud Messaging. Backend only.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=             # path to the service account file
# iOS: Apple Push Notification service. Backend only.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.eastmarket.ios
APNS_AUTH_KEY_PATH=

# ---------------------------------------------------------------------------
# Payment providers
# ---------------------------------------------------------------------------
# Providers are registered as rows in public.payment_providers; only their
# SECRETS live here, keyed by provider code. Leave blank to keep a provider
# disabled. Never expose any of these to a client.
EM_PAY_ZAAD_MERCHANT_ID=
EM_PAY_ZAAD_API_KEY=
EM_PAY_EDAHAB_MERCHANT_ID=
EM_PAY_EDAHAB_API_KEY=
EM_PAY_EVCPLUS_MERCHANT_ID=
EM_PAY_EVCPLUS_API_KEY=
EM_PAY_SAHAL_MERCHANT_ID=
EM_PAY_SAHAL_API_KEY=
EM_PAY_TELEBIRR_APP_ID=
EM_PAY_TELEBIRR_APP_KEY=
EM_PAY_TELEBIRR_PUBLIC_KEY=
EM_PAY_MPESA_CONSUMER_KEY=
EM_PAY_MPESA_CONSUMER_SECRET=
EM_PAY_MPESA_SHORTCODE=
EM_PAY_MPESA_PASSKEY=
EM_PAY_WEBHOOK_SECRET=                # shared secret for verifying callbacks

# ---------------------------------------------------------------------------
# Exchange rates
# ---------------------------------------------------------------------------
# Optional. Without it, public.exchange_rates keeps its seeded values and is
# updated by hand from the admin dashboard.
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------------------------
# Deep links
# ---------------------------------------------------------------------------
DEEPLINK_HOST=eastmarket.app
ANDROID_PACKAGE_NAME=app.eastmarket.android
ANDROID_SHA256_CERT_FINGERPRINTS=
IOS_APP_STORE_ID=
IOS_TEAM_ID=
