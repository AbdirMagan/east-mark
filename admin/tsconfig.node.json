{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023"], "module": "ESNext",
    "moduleResolution": "bundler", "types": ["node"], "isolatedModules": true,
    "verbatimModuleSyntax": true, "noEmit": true, "skipLibCheck": true, "strict": true,
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
