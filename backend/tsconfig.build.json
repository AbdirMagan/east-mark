{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Only the build needs an output layout; the editor and `npm run
    // typecheck` also compile tests/, which sit outside src/.
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "src/**/*.test.ts"]
}
